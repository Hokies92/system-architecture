# Database Configuration
# PostgreSQL connection string (use Neon serverless or your own PostgreSQL instance)
DATABASE_URL=postgresql://username:password@host:port/database

# Session Secret
# IMPORTANT: Generate a secure random string for production (min 32 characters)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Application Environment
NODE_ENV=development

# Application URL (optional but recommended)
# Used for generating verification email links
APP_URL=http://localhost:5000

# Stripe Configuration (optional - for payment integration)
# Get your API keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
